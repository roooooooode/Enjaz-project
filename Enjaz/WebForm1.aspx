<!-- Interactive Local JavaScript micro-interactions -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      // Portfolio URL Copy Micro-Interaction
      const copyBtn = document.getElementById('btn-copy-portfolio');
      const copyBadge = document.getElementById('copy-badge');
      if (copyBtn && copyBadge) {
        copyBtn.addEventListener('click', () => {
          navigator.clipboard?.writeText('https://enjaz.edu.sa/p/sarah-cs');
          const original = copyBadge.textContent;
          copyBadge.textContent = 'Copied! ✓';
          copyBadge.classList.replace('bg-secondary-container', 'bg-primary');
          copyBadge.classList.replace('text-on-secondary-container', 'text-on-primary');
          setTimeout(() => {
            copyBadge.textContent = original;
            copyBadge.classList.replace('bg-primary', 'bg-secondary-container');
            copyBadge.classList.replace('text-on-primary', 'text-on-secondary-container');
          }, 2000);
        });
      }

      // Quick Upload Drop-zone interaction
      const dropZone = document.getElementById('drop-zone');
      const submitBtn = document.getElementById('btn-submit');
      if (dropZone && submitBtn) {
        let isSelected = false;
        dropZone.addEventListener('click', () => {
          isSelected = !isSelected;
          if (isSelected) {
            dropZone.classList.add('bg-secondary-container/20');
            dropZone.querySelector('.font-label-lg').textContent = 'File attached: Capstone_SRS_v2.pdf (4.2 MB)';
            submitBtn.classList.replace('bg-primary', 'bg-secondary');
          } else {
            dropZone.classList.remove('bg-secondary-container/20');
            dropZone.querySelector('.font-label-lg').textContent = 'Tap to select or drop files here';
            submitBtn.classList.replace('bg-secondary', 'bg-primary');
          }
        });

        submitBtn.addEventListener('click', () => {
          const originalHtml = submitBtn.innerHTML;
          submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>Submitting...</span>';
          setTimeout(() => {
            submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span><span>Submitted!</span>';
            submitBtn.classList.replace('bg-secondary', 'bg-secondary-container');
            submitBtn.classList.replace('text-on-primary', 'text-on-secondary-container');
            setTimeout(() => {
              submitBtn.innerHTML = originalHtml;
              submitBtn.classList.replace('bg-secondary-container', 'bg-primary');
              submitBtn.classList.replace('text-on-secondary-container', 'text-on-primary');
            }, 2500);
          }, 1200);
        });
      }
    });
</script>
